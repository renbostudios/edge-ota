{
  "name": "@renbostudios/edge-ota",
  "version": "0.4.2",
  "preferGlobal": true,
  "description": "Zero-SDK, self-hostable OTA update CLI for Expo — push signed JS bundles to any EdgeOTA server",
  "license": "MIT",
  "author": "EdgeOTA Contributors",
  "homepage": "https://github.com/renbostudios/edge-ota-cli",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/itskodaaa/edge-ota.git",
    "directory": "apps/cli"
  },
  "bugs": {
    "url": "https://github.com/renbostudios/edge-ota-cli/issues"
  },
  "keywords": [
    "expo",
    "ota",
    "updates",
    "react-native",
    "cli",
    "edge",
    "cloudflare"
  ],
  "type": "module",
  "bin": {
    "edge-ota": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@renbostudios/edge-ota-core": "workspace:*",
    "@types/archiver": "^6.0.2",
    "@types/node": "^20.12.12",
    "tsup": "^8.5.1",
    "typescript": "^5.4.5"
  }
}
