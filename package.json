{
  "name": "edge-ota",
  "private": true,
  "description": "Zero-SDK, self-hostable OTA update platform for Expo — CLI, Server, and Worker",
  "homepage": "https://ota.renbo.site",
  "repository": {
    "type": "git",
    "url": "https://github.com/renbostudios/edge-ota.git"
  },
  "engines": {
    "node": "24.x",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev:cli": "pnpm --filter @renbostudios/edge-ota dev",
    "dev:worker": "pnpm --filter @edge-ota/worker-oss dev",
    "dev:server": "pnpm --filter @edge-ota/server-node dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r clean",
    "changeset": "changeset",
    "ci:version": "changeset version",
    "ci:publish": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "typescript": "^5.4.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp",
      "workerd",
      "prebuild-install"
    ]
  }
}
